import math
import native = "./native.qui"

class Reader
    private bin source
    private int frame_width
    private int frame_height
    private real64 frame_rate
    private int frame_count
    private real64 stream_duration
    private int frame_position

    construct(
        bin bytes,
        int width,
        int height,
        real64 fps,
        int frames,
        real64 duration
    )
        this.source = bytes
        this.frame_width = width
        this.frame_height = height
        this.frame_rate = fps
        this.frame_count = frames
        this.stream_duration = duration
        this.frame_position = 0

    int width()
        return this.frame_width

    int height()
        return this.frame_height

    real64 fps()
        return this.frame_rate

    int frames()
        return this.frame_count

    real64 duration()
        return this.stream_duration

    int position()
        return this.frame_position

    void | error seek(int frame)
        if frame < 0
            return error("video.Reader.seek frame cannot be negative")
        if this.frame_count >= 0 and frame > this.frame_count
            return error("video.Reader.seek frame is beyond end of stream")
        this.frame_position = frame
        return

    tensor<T> | none | error read<T: numeric>(int channel = 3)
        if channel != 1 and channel != 3 and channel != 4
            return error("video.Reader.read channel must be 1, 3, or 4")
        tensor<T> output = tensor.zeros<T>([
            nat(channel), nat(this.frame_height), nat(this.frame_width)
        ])
        bin source_bytes = this.source
        int32 status = native.decode<T>(
            &source_bytes, int64(this.frame_position), int64(channel), &output
        )
        if status == int32(1)
            return none
        if status != int32(0)
            return error("video.Reader.read failed to decode the requested frame")
        this.frame_position += 1
        return output

Reader | error open(string path)
    bin bytes = try file.read_bin(path)
    tensor<real64> metadata = tensor.zeros<real64>([5])
    int32 status = native.probe(&bytes, &metadata)
    if status != int32(0)
        return error("video.open failed to read video metadata")
    int width = math.trunc(metadata[0].item())
    int height = math.trunc(metadata[1].item())
    real64 fps = metadata[2].item()
    int frames = math.trunc(metadata[3].item())
    real64 duration = metadata[4].item()
    if width <= 0 or height <= 0
        return error("video.open decoded invalid frame dimensions")
    return Reader(bytes, width, height, fps, frames, duration)
